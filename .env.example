# Omni Find — Environment Variables
# Copy this file to ".env" and adjust as needed.
# Vite only exposes variables prefixed with VITE_ to the client.

# Base URL for the product API.
# Default uses the free DummyJSON product API (no key required).
VITE_PRODUCT_API_BASE_URL=https://dummyjson.com

# Optional: number of products fetched per page/request.
VITE_PRODUCTS_PAGE_SIZE=12

# If you swap in a provider that requires an API key, add it here.
# Never commit your real .env file — it is already listed in .gitignore.
# VITE_PRODUCT_API_KEY=your_api_key_here
